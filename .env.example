# CertDojo runs in one of two mutually exclusive modes, detected automatically:
#
# - Vercel mode: if POSTGRES_URL is present (injected by the Vercel Postgres /
#   Neon integration, DATABASE_URL is accepted as an equivalent), the app uses
#   the Postgres adapter.
# - Local mode (default): no Postgres variable set, the app uses a local SQLite
#   file. All data stays on your machine.
#
# There is no mode toggle: leave both Postgres variables unset for Local mode.

# POSTGRES_URL is checked first; DATABASE_URL is an accepted equivalent.
# Setting either one switches the app to Vercel/Postgres mode.
# POSTGRES_URL=postgres://user:password@host/database
# DATABASE_URL=postgres://user:password@host/database

# Local mode only: override the SQLite file path (default: data/certdojo.db)
# SQLITE_PATH=data/certdojo.db
